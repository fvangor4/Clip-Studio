# Copy this file to .env and adjust the paths for your machine.
# Docker Compose reads .env automatically.

# Folder containing your OBS recordings (mounted read-only into the containers).
# Use forward slashes, even on Windows.
RECORDINGS_PATH=C:/Users/you/Videos/OBS recordings

# Where rendered verticals are written on the host (default: ./output in the repo).
#OUTPUT_PATH=./output
